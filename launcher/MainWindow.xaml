<Window x:Class="WhaleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="助手" Icon="Assets/app.ico" Height="840" Width="1320" MinHeight="640" MinWidth="1080"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontSize="14"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 背景图：只在设置里选过图片时显示；上面压一层主题蒙版保证可读 -->
        <Grid x:Name="BackdropLayer" Grid.RowSpan="3" Visibility="Collapsed"
              ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="BackdropImage" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <!-- 略微放大，避免高斯模糊在四周产生透明的软边 -->
                <Image.RenderTransform>
                    <ScaleTransform x:Name="BackdropScale" ScaleX="1.06" ScaleY="1.06" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect x:Name="BackdropBlurEffect" Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Border Background="{DynamicResource BackdropTint}" />
        </Grid>

        <!-- 顶栏：配色固定，不跟随莫奈 / 自定义颜色；内部做成 Fluent 标题区，系统标题栏仍保留 -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource BgTop}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" VerticalAlignment="Center" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource Accent}">
                        <Path Data="F0 M92,50 H164 A36,36 0 0,1 200,86 V138 A36,36 0 0,1 164,174 H116 L68,208 L76,174 H92 A36,36 0 0,1 56,138 V86 A36,36 0 0,1 92,50 Z M128,82 Q136.4,101.6 156,110 Q136.4,118.4 128,138 Q119.6,118.4 100,110 Q119.6,101.6 128,82 Z"
                              Fill="{DynamicResource PrimaryFg}" Stretch="Uniform" Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="助手" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />

                    <Border Background="{DynamicResource Surface3}" CornerRadius="4" Padding="7,2"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v4.0-alpha" Foreground="{DynamicResource Muted}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>

                    <Border Width="1" Height="18" Background="{DynamicResource Line}"
                            Margin="18,0,18,0" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotNode" Width="7" Height="7" Fill="{DynamicResource Idle}" />
                                <TextBlock x:Name="NodeStateText" Text="内核未启动" Foreground="{DynamicResource Text}"
                                           FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotBridge" Width="7" Height="7" Fill="{DynamicResource Idle}" />
                                <TextBlock Text="桥接" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BridgeStateText" Text="未启动" Foreground="{DynamicResource Text}"
                                           FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotWechat" Width="7" Height="7" Fill="{DynamicResource Idle}" />
                                <TextBlock x:Name="WechatLabel" Text="微信" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="WechatStateText" Text="未登录" Foreground="{DynamicResource Text}"
                                           FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- 在岗只在开启时出现；关掉后不占位置，不让人长期盯着一枚灰胶囊 -->
                        <Border x:Name="ChipOnDuty" Style="{StaticResource Chip}" Visibility="Collapsed"
                                AutomationProperties.Name="分身在岗已开启"
                                ToolTip="分身正在按对象策略代回消息">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotOnDuty" Width="7" Height="7" Fill="{DynamicResource Ok}" />
                                <TextBlock Text="在岗" Foreground="{DynamicResource Text}" FontSize="12.5"
                                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTheme" Style="{StaticResource TopBtn}" Width="32" Height="32" Padding="0" AutomationProperties.Name="切换主题"
                            Click="OnToggleTheme" ToolTip="主题：跟随系统 · 点击切换">
                        <Grid Width="16" Height="16">
                            <TextBlock x:Name="IconMoon" Text="&#xE708;" FontFamily="{StaticResource IconFont}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock x:Name="IconSun" Text="&#xE706;" Visibility="Collapsed" FontFamily="{StaticResource IconFont}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock x:Name="IconSystem" Text="&#xE7F4;" Visibility="Collapsed" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource TopBtn}" Width="32" Height="32" Padding="0" AutomationProperties.Name="设置"
                            Click="OnSettings" ToolTip="设置" Margin="2,0,0,0">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="BtnToggle" Style="{StaticResource Primary}" Margin="10,0,0,0" Click="OnToggle"
                            AutomationProperties.Name="启动" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="BtnToggleText" Text="停止" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 浮层与主区共用一行，通过 ZIndex 覆盖显示，不参与主区高度分配 -->
        <Border x:Name="UpdateToast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="640"
                Margin="20,10,20,8" CornerRadius="8" Padding="16,12" Visibility="Collapsed"
                Panel.ZIndex="9"
                BorderThickness="1">
            <Border.RenderTransform><TranslateTransform x:Name="UpdateToastSlide" /></Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PopupBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="立即更新" Style="{StaticResource Primary}" Click="OnToastUpdateClick" />
                        <Button Content="暂时收起" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnToastDismissClick" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateToastText" Text="已检测到新版本" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}" />
                </DockPanel>
                <TextBlock x:Name="UpdateToastWarning" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,8,0,2" Visibility="Collapsed" />
                <TextBlock x:Name="UpdateToastNotes" FontSize="12" Foreground="{DynamicResource Text2}"
                           LineHeight="16" TextWrapping="Wrap" Margin="0,6,0,2" />
                <Expander x:Name="UpdateToastDetailsExpander" Header="详细更新" IsExpanded="False"
                          Margin="0,4,0,0" Foreground="{DynamicResource Text}">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="UpdateToastDetails" FontSize="12" Foreground="{DynamicResource Text2}"
                                   LineHeight="16" TextWrapping="Wrap" Margin="0,4,0,2" />
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>

        <!-- 左栏 + 主区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgNav}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,12">
                    <!-- NavigationView 式分组标题 -->
                    <TextBlock DockPanel.Dock="Top" Text="导航" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Dim}" Margin="12,0,0,8" />

                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0,0,0,0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             IsSynchronizedWithCurrentItem="False"
                             SelectionChanged="OnNavChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 内容区纸面：正文压在背景图上时给一层底，暗图 / 花图也能看清字 -->
            <Border Grid.Column="1" Background="{DynamicResource BgContent}" ClipToBounds="True">
                <ContentControl x:Name="Host" />
            </Border>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BgFoot}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLine" DockPanel.Dock="Left" Text="启动器就绪"
                           Style="{StaticResource Small}" VerticalAlignment="Center" />
                <!-- 更新进度：平时收起，点「现在更新」才出现 -->
                <TextBlock x:Name="UpdatePct" DockPanel.Dock="Right" Text="" Visibility="Collapsed"
                           Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <ProgressBar x:Name="UpdateBar" DockPanel.Dock="Right" Width="180" Height="4"
                             Minimum="0" Maximum="100" IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" BorderThickness="0"
                             Background="{DynamicResource LineSoft}" Foreground="{DynamicResource Accent}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
