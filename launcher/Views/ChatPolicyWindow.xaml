<UserControl x:Class="WhaleLauncher.Views.ChatPolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="512" Height="412"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <!--
        弹层正文固定 512×412：加上 AppDialog 的标题栏和底部按钮正好是 560×560 的卡片，
        高于 480×420 的最小尺寸要求；内容超出时只让名单列表在自己的卡片里滚动，
        这里不放整页 ScrollViewer。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 一行当前状态 + 一行保存结果，不铺垫说明文字 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource Text2}" FontSize="13" LineHeight="18"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="SaveState" Grid.Column="1" Style="{StaticResource Small}" MaxWidth="154"
                           Margin="12,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="ErrorLine" Foreground="{DynamicResource Bad}" FontSize="12" LineHeight="17"
                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="TabHost" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" />

        <Grid Grid.Row="2">
            <!-- 黑名单：这些会话完全不处理；影响预览只在这一段出现 -->
            <Grid x:Name="MutedPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="这些会话完全不处理。" Style="{StaticResource Small}" />
                <Border Grid.Row="1" Background="{DynamicResource Surface3}" CornerRadius="4"
                        Padding="8,4" Margin="0,6,0,0">
                    <TextBlock Text="对这些会话：不回复、不解码图片/表情、不主动搭话"
                               Foreground="{DynamicResource Warn}" FontSize="12" LineHeight="16"
                               TextWrapping="Wrap" />
                </Border>
                <ContentControl x:Name="MutedHost" Grid.Row="2" Margin="0,8,0,0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>

            <!-- 白名单：开关属于这一段；关闭时标成「仅用于主动搭话」 -->
            <Grid x:Name="WhitelistPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="WhitelistOnly" Content="仅白名单模式" FontSize="13" FontWeight="SemiBold"
                              Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                              Click="OnWhitelistOnly" />
                    <Border x:Name="WhitelistTag" Background="{DynamicResource Surface3}" CornerRadius="4"
                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="仅用于主动搭话" Foreground="{DynamicResource Text2}" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="WhitelistPurpose" Grid.Row="1" Style="{StaticResource Small}"
                           Margin="0,5,0,0" TextWrapping="Wrap" />
                <ContentControl x:Name="WhitelistHost" Grid.Row="2" Margin="0,8,0,0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
