<UserControl x:Class="WhaleLauncher.Views.ContactCheckList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 已选名单的一行：整行只在悬浮时给底色，不给选中态，避免和「移除」抢注意力 -->
        <Style x:Key="PolicyRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具行：黑名单多一个「全部会话」，名单超过 8 个才出现筛选框 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <CheckBox x:Name="ChkAll" Content="全部会话都不处理" FontSize="12" Margin="0,0,10,0"
                          VerticalAlignment="Center" Checked="OnAllMuteChanged" Unchecked="OnAllMuteChanged"
                          Visibility="Collapsed" />
                <Button x:Name="BtnAdd" Content="添加会话" Style="{StaticResource Ghost}"
                        Padding="10,3" FontSize="12" Click="OnTogglePicker" />
            </StackPanel>
            <StackPanel x:Name="FilterHost" Orientation="Horizontal" HorizontalAlignment="Right"
                        Visibility="Collapsed">
                <TextBlock Text="筛选" Style="{StaticResource Small}" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Width="160" FontSize="12"
                         TextChanged="OnSearchChanged"
                         ToolTip="按名字 / 备注 / wxid 筛选已选会话" />
            </StackPanel>
        </Grid>

        <Border x:Name="ListCard" Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                         KeyboardNavigation.TabNavigation="Continue"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PolicyRow}" ToolTip="{Binding Wxid}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Text}"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Grid.Column="1" Background="{DynamicResource Surface3}" CornerRadius="4"
                                            Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Text2}" FontSize="12" />
                                    </Border>
                                    <Button Grid.Column="2" Content="移除" Style="{StaticResource TopBtn}"
                                            FocusVisualStyle="{StaticResource FluentFocusVisual}"
                                            FontSize="12" Padding="8,3" Click="OnRemove"
                                            AutomationProperties.Name="{Binding RemoveName}"
                                            ToolTip="从名单移除" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空名单 / 全部不处理 / 搜不到时的可执行提示 -->
                <TextBlock x:Name="StateText" Foreground="{DynamicResource Text2}" FontSize="13"
                           LineHeight="18" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="360" Margin="20" Visibility="Collapsed" />

                <!-- 添加会话：复用联系人目录，多选后一次性加进名单并立即保存 -->
                <Grid x:Name="PickerPanel" Background="{DynamicResource CardBg}" Margin="2"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PickerSearch" FontSize="12" TextChanged="OnPickerSearchChanged"
                             ToolTip="按名字 / 备注 / wxid 搜索联系人" />
                    <Grid Grid.Row="1" Margin="0,6,0,6">
                        <ListBox x:Name="PickerList" Background="Transparent" BorderThickness="0"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Padding="4,5" HorizontalContentAlignment="Stretch"
                                              IsChecked="{Binding IsPicked, Mode=TwoWay}" Click="OnPickToggled"
                                              ToolTip="{Binding Wxid}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Text}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                       Foreground="{DynamicResource Text2}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PickerState" Foreground="{DynamicResource Dim}" FontSize="12"
                                   LineHeight="17" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="320" Margin="16" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource Ghost}" Padding="10,3" FontSize="12"
                                Click="OnClosePicker" />
                        <Button x:Name="BtnAddPicked" Content="添加所选" Style="{StaticResource Primary}"
                                Padding="12,3" FontSize="12" Margin="8,0,0,0" IsEnabled="False"
                                Click="OnAddPicked" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
