<UserControl x:Class="WhaleLauncher.Views.MomentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  FocusVisualStyle="{x:Null}">
        <Grid x:Name="PageRoot" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="PageHeader" Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="朋友圈" Style="{StaticResource H1}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleStatus" Style="{StaticResource Small}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="本地缓存读取、互动与自动发表。" Foreground="{DynamicResource Text2}"
                               FontSize="14" LineHeight="20" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- 自动发表：默认只留总开关和定时开关 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="自动发表" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PublishSaveState" Text="自动保存" Style="{StaticResource Small}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel>
                        <CheckBox x:Name="ChkPublishFeature" Content="启用朋友圈发表" Margin="0,0,20,0" Click="OnPublishToggle" />
                        <CheckBox x:Name="ChkPublish" Content="定时自动发表" Click="OnPublishToggle" />
                    </WrapPanel>
                    <TextBlock x:Name="PublishStatus" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 读取：最常用的是关键词和“读取最近 20 条” -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="读取本地缓存" Style="{StaticResource H2}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <CheckBox x:Name="ChkOwn" DockPanel.Dock="Right" Content="只看自己" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtKeyword" VerticalAlignment="Center"
                                 ToolTip="留空读取最近动态；填写后只显示正文包含该关键词的动态" />
                        <Button x:Name="BtnRead" Grid.Column="1" Content="读取最近 20 条" Style="{StaticResource Primary}"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <Expander Header="高级" IsExpanded="False" Foreground="{DynamicResource Text}" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="自动发表细节" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <CheckBox x:Name="ChkPublishImage" Content="按情绪配一张图片" Margin="0,0,20,0" Click="OnPublishToggle" />
                                <TextBlock Text="每隔（小时）" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtPublishInterval" Width="56" Margin="0,0,16,0" LostFocus="OnPublishFieldLostFocus" />
                                <TextBlock Text="每天最多" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtPublishLimit" Width="56" LostFocus="OnPublishFieldLostFocus" />
                            </WrapPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnTestPublish" Content="立即发表一条" Style="{StaticResource Ghost}" />
                                <Button x:Name="BtnRefreshPublish" Content="刷新状态" Style="{StaticResource Ghost}" Margin="8,0,0,0" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="BtnPublishHappy" Content="开心图片目录" Style="{StaticResource Ghost}" Margin="0,0,6,0" />
                                <Button x:Name="BtnPublishCute" Content="傲娇图片目录" Style="{StaticResource Ghost}" Margin="0,0,6,0" />
                                <Button x:Name="BtnPublishAngry" Content="炸毛图片目录" Style="{StaticResource Ghost}" />
                            </WrapPanel>

                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12" />

                            <TextBlock Text="读取与自动互动" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkAutoLike" Content="自动点赞（模型判断）" VerticalAlignment="Center" Click="OnAutoLikeChanged"
                                      ToolTip="只对积极、非求助的动态判断；每天有上限" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="自动读取" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbAutoRead" Width="132" FontSize="13" Margin="8,0,0,0" SelectionChanged="OnAutoReadChanged">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="每 4 小时" Tag="4" />
                                    <ComboBoxItem Content="每 6 小时" Tag="6" />
                                    <ComboBoxItem Content="每 12 小时" Tag="12" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="AutoStatus" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="发布者内部 ID（可留空，不是昵称）" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <TextBox x:Name="TxtUsername" ToolTip="只筛选指定 wxid 的动态，不是昵称" />

                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12" />

                            <TextBlock Text="手动互动" Style="{StaticResource H2}" Margin="0,0,0,8" />
                            <TextBlock Text="用上方正文关键词定位目标。" Style="{StaticResource Small}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="发布者准确昵称" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtPublisher" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="动作" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="ActionBox" FontSize="13" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="评论内容 / 发布文案草稿" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <TextBox x:Name="TxtComment" />
                            <TextBlock Text="被回复者昵称（仅回复评论）" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <TextBox x:Name="TxtReplyTo" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="BtnInteract" Content="执行所选互动" Style="{StaticResource Ghost}" />
                                <Button x:Name="BtnDraft" Content="复制文案" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                        ToolTip="只复制到剪贴板，到朋友圈里手动发表" />
                            </WrapPanel>
                            <TextBlock Text="结果未确认时不要重复操作。" Style="{StaticResource Small}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 读取结果 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,8" Height="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,12,16,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="读取结果" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="尚未读取。" Style="{StaticResource Small}"
                               Margin="16,4,16,6" TextWrapping="Wrap" />

                    <TextBox x:Name="TxtOutput" Grid.Row="2" Margin="16,0,16,14" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource Text2}" FontSize="13" FocusVisualStyle="{x:Null}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
