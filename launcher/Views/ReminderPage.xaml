<UserControl x:Class="WhaleLauncher.Views.ReminderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WhaleLauncher"
             Background="Transparent">
    <Grid x:Name="PageRoot" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="PageHeader" Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="主动提醒" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <TextBlock Text="日记、提醒和主动搭话。" Foreground="{DynamicResource Text2}"
                           FontSize="14" LineHeight="20" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="刷新"
                    Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh" />
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="HintText" Visibility="Collapsed" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="0,0,8,0">

                <!-- 日记：默认只留开关、时间和状态 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="日记" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DiaryTitleStatus" Text="自动保存" Style="{StaticResource Small}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox x:Name="ChkDiaryEnabled" DockPanel.Dock="Right" Content="每天自动写" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel>
                            <ui:TimeField x:Name="TxtDiaryTime" Text="23:00" Width="84" Mode="Clock" AllowEmpty="False" Label="日记时间" />
                            <TextBlock x:Name="DiaryStatus" Text="尚未生成日记" Foreground="{DynamicResource Text2}"
                                       FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BtnWriteDiary" Content="立即写一篇" Style="{StaticResource Ghost}" Click="OnWriteDiary" />
                            <Button Content="打开文件夹" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnOpenDiary" />
                            <TextBlock x:Name="DiarySettingsStatus" Style="{StaticResource Small}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 提醒规则：默认只留开关和每日上限 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="提醒规则" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RulesTitleStatus" Text="自动保存" Style="{StaticResource Small}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="ChkEnabled" Content="开启提醒" Margin="0,0,20,0" VerticalAlignment="Center" />
                            <TextBlock Text="每天最多" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:NumberField x:Name="TxtMaxPerDay" Width="90" Minimum="0" Maximum="200" Fallback="0" Label="每天最多提醒几次" />
                            <TextBlock Text="次（0 = 不限）" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="6,0,16,0" />
                            <TextBlock x:Name="RulesStatus" Style="{StaticResource Small}" Margin="0,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 主动搭话：默认留总开关、平均间隔和时间段 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="主动搭话" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CareTitleStatus" Text="自动保存" Style="{StaticResource Small}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="ChkCareEnabled" Content="开启主动搭话" Margin="0,0,0,10" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="平均间隔（分钟）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <ui:NumberField x:Name="TxtCareEvery" Width="96" HorizontalAlignment="Left"
                                                Minimum="5" Maximum="1440" Fallback="90" Label="平均间隔" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="允许的时间段（如 09:00-12:00）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <ui:TimeField x:Name="TxtCareWindows" Mode="Ranges" AllowEmpty="True" Label="搭话时间段"
                                              Width="260" MinHeight="34" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock x:Name="CareStatus" Style="{StaticResource Small}" Margin="0,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 一个高级入口收齐低频项 -->
                <Expander Header="高级" IsExpanded="False" Foreground="{DynamicResource Text}" Margin="0,0,0,12">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="日记设置" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkDiarySend" Content="写完发给主要联系人" />
                                <TextBlock Text="保存位置：data/diary/年份/月-日.md" Style="{StaticResource Small}"
                                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="每天最多一篇；错过时间会补写；失败最多重试 3 次。"
                                           Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="提醒细节" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <TextBlock Text="刚聊过先跳过（分钟）" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ui:NumberField x:Name="TxtQuiet" Width="90" Minimum="0" Maximum="1440" Fallback="0" Label="刚聊过先跳过" />
                                </WrapPanel>
                                <TextBlock Text="当日次数用完或刚聊过就不发，不推迟补发；提醒不受时间段限制。"
                                           Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="主动搭话细节" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="间隔浮动（分钟）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                        <ui:NumberField x:Name="TxtCareJitter" Width="90" HorizontalAlignment="Left"
                                                        Minimum="0" Maximum="180" Fallback="25" Label="间隔浮动" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="每天最多（0 = 不限）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                        <ui:NumberField x:Name="TxtCareMax" Width="90" HorizontalAlignment="Left"
                                                        Minimum="0" Maximum="50" Fallback="0" Label="每天最多几次" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="刚聊过先跳过（分钟）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                        <ui:NumberField x:Name="TxtCareQuiet" Width="90" HorizontalAlignment="Left"
                                                        Minimum="0" Maximum="240" Fallback="0" Label="刚聊过先跳过" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="ChkCareOnlyMaster" Content="只找主要联系人" Margin="0,0,18,0" />
                                    <CheckBox x:Name="ChkCareGroups" Content="允许在群里主动" Margin="0,0,18,0" />
                                    <CheckBox x:Name="ChkCareOthers" Content="允许主动找别人" />
                                </WrapPanel>
                                <TextBlock Text="发言范围在「微信 → 发言范围」里调整。"
                                           Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <!-- 提醒列表 -->
                <Border Style="{StaticResource Card}" Padding="12" MinHeight="160">
                    <Grid>
                        <ItemsControl x:Name="ReminderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Text}"
                                                           FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                           FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Wxid}" Style="{StaticResource Small}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Muted}"
                                                           FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding ErrorVisibility}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="删除" Style="{StaticResource Ghost}"
                                                    Tag="{Binding Id}" Click="OnCancelReminder"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyText" Text="还没有提醒" Style="{StaticResource Small}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="24" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource Small}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
