<UserControl x:Class="WhaleLauncher.Views.SelfPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WhaleLauncher"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 域胶囊：多选，空格切换。焦点用 2px 描边，选中用底色 + 文字色，不靠颜色单编码。 -->
        <Style x:Key="ScopeChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="10" MinHeight="26" Padding="10,3"
                                Background="Transparent" BorderBrush="{DynamicResource LineSoft}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Text}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 只读标签：来源、域、理由。文字本身携带状态，颜色只做辅助。 -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 列表行：键盘焦点落在行内任何控件上时，整行出现 2px 焦点环。 -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="host" CornerRadius="6" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="12,10">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="focusRing" CornerRadius="6" BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="2" Margin="-2" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="host" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="host" Property="Background" Value="{DynamicResource Surface3}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="focusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelfList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,4,0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 对象列表行：名字 + 关系摘要，详细设置放到右边的编辑卡 -->
        <DataTemplate x:Key="PolicyRowTemplate">
            <StackPanel AutomationProperties.Name="{Binding DisplayName}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" Style="{StaticResource Small}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Uid}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" FontSize="12" LineHeight="16"
                           Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- 知识 / 资产 / 待确认里的域标签 -->
        <DataTemplate x:Key="ScopePillTemplate">
            <Border Style="{StaticResource Pill}">
                <TextBlock Text="{Binding Label}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Key}" Value="private">
                                    <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20" KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：一句话讲清共享层 / 关系层，不铺说明墙 -->
        <StackPanel Grid.Row="0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="分身" Style="{StaticResource H1}" DockPanel.Dock="Left" />
                <Button x:Name="BtnReload" Content="重新读取" Style="{StaticResource Ghost}"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnReloadAll"
                        AutomationProperties.Name="重新读取分身设置" />
            </DockPanel>
            <TextBlock Text="共享层（自我档案、知识、资产、在岗）所有对象共用，按权限域过滤；对象权限只对那一个对象生效。"
                       Foreground="{DynamicResource Text2}" FontSize="14" LineHeight="20"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 分段：页签由 SegmentedTabs 统一生成，这里只放容器 -->
        <StackPanel x:Name="TabBar" Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0" />

        <!-- 失败提示：不打断页面，给一句人话 + 重试 -->
        <Border x:Name="Banner" Grid.Row="2" Style="{StaticResource Card}" Padding="12,10"
                Margin="0,10,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource Warn}">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnBannerRetry" DockPanel.Dock="Right" Content="重试" Style="{StaticResource Ghost}"
                        Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center" Click="OnReloadAll" />
                <TextBlock DockPanel.Dock="Left" Text="!" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock x:Name="BannerText" FontSize="14" LineHeight="20" Foreground="{DynamicResource Text}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="BannerDetail" Style="{StaticResource Small}" TextWrapping="Wrap"
                               Margin="0,2,0,0" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Body" Grid.Row="3" Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,10,8">
                <!-- ══════════ 1. 自我档案 ══════════ -->
                <StackPanel x:Name="SecSelf" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="身份" Style="{StaticResource H2}" />
                            <TextBlock Text="分身用这套身份跟别人说话，保存后下一轮回复生效。"
                                       Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <Label Content="姓名" Target="{Binding ElementName=TxtSelfName}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfName" AutomationProperties.Name="分身姓名" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="别名" Target="{Binding ElementName=TxtSelfAliases}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfAliases" AutomationProperties.Name="别名"
                                             ToolTip="多个别名用顿号或逗号分隔" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <Label Content="年龄" Target="{Binding ElementName=TxtAge}" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberField x:Name="TxtAge" Minimum="0" Maximum="120" Fallback="0"
                                                    Label="年龄" AutomationProperties.Name="年龄" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <Label Content="城市" Target="{Binding ElementName=TxtSelfCity}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfCity" AutomationProperties.Name="城市" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Label Content="职业" Target="{Binding ElementName=TxtSelfJob}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfJob" AutomationProperties.Name="职业" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                    <Label Content="公司" Target="{Binding ElementName=TxtSelfCompany}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfCompany" AutomationProperties.Name="公司" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="语气" Style="{StaticResource H2}" />
                            <TextBlock Text="在岗时用这里的语气代替助手人设；留空就按默认风格说话。"
                                       Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="说话语气" Target="{Binding ElementName=TxtSelfTone}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfTone" MinHeight="64" MaxHeight="120" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="说话语气" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="句长与句式" Target="{Binding ElementName=TxtSelfSentence}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfSentence" MinHeight="64" MaxHeight="120" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="句长与句式" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                            </Grid>

                            <Expander Header="口头禅、表情与禁忌词（高级）" IsExpanded="False"
                                      Foreground="{DynamicResource Text}" Margin="0,14,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <Label Content="口头禅" Target="{Binding ElementName=TxtSelfCatchphrases}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TxtSelfCatchphrases" AutomationProperties.Name="口头禅"
                                             ToolTip="用顿号或逗号分隔，例如：行、我看看、这个得排期" TextChanged="OnSelfFieldChanged" />
                                    <Label Content="表情习惯" Target="{Binding ElementName=TxtSelfEmoji}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <TextBox x:Name="TxtSelfEmoji" AutomationProperties.Name="表情习惯" TextChanged="OnSelfFieldChanged" />
                                    <Label Content="禁忌词" Target="{Binding ElementName=TxtSelfTaboo}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <TextBox x:Name="TxtSelfTaboo" AutomationProperties.Name="禁忌词"
                                             ToolTip="用顿号或逗号分隔，例如：亲、宝子" TextChanged="OnSelfFieldChanged" />
                                </StackPanel>
                            </Expander>

                            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                <Button x:Name="BtnSaveSelf" Content="保存" Style="{StaticResource Primary}"
                                        DockPanel.Dock="Left" Click="OnSaveSelfClick" AutomationProperties.Name="保存自我档案" />
                                <TextBlock x:Name="SelfSaveState" DockPanel.Dock="Left" Style="{StaticResource Small}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="SelfError" DockPanel.Dock="Right" Foreground="{DynamicResource Bad}"
                                           FontSize="12" LineHeight="16" TextWrapping="Wrap" VerticalAlignment="Center"
                                           MaxWidth="360" Visibility="Collapsed" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════ 2. 信息与权限 ══════════ -->
                <StackPanel x:Name="SecKnowledge" Visibility="Collapsed">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="信息与权限" Style="{StaticResource H2}" />
                            <TextBlock Text="每条知识按域决定谁能看到；私有域不会发给任何对象。"
                                       Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnNewKnowledge" DockPanel.Dock="Right" Content="新增知识" Style="{StaticResource Primary}"
                                VerticalAlignment="Center" Click="OnNewKnowledge" AutomationProperties.Name="新增知识条目" />
                    </DockPanel>

                    <Border x:Name="KnowledgeEditor" Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="KnowledgeEditorTitle" Text="新增知识" Style="{StaticResource H2}" />
                            <Label Content="标题" Target="{Binding ElementName=TxtKnowledgeTitle}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <TextBox x:Name="TxtKnowledgeTitle" MaxLength="60" AutomationProperties.Name="知识标题" />
                            <Label Content="内容" Target="{Binding ElementName=TxtKnowledgeText}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <TextBox x:Name="TxtKnowledgeText" MinHeight="86" MaxHeight="220" AcceptsReturn="True"
                                     MaxLength="800" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="知识内容" TextChanged="OnKnowledgeTextChanged" />
                            <DockPanel LastChildFill="False" Margin="0,4,0,0">
                                <TextBlock x:Name="KnowledgeCounter" DockPanel.Dock="Right" Style="{StaticResource Small}"
                                           Text="0 / 800" />
                                <TextBlock x:Name="KnowledgeError" DockPanel.Dock="Left" Foreground="{DynamicResource Bad}"
                                           FontSize="12" LineHeight="16" TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                            <Label Content="谁能看到" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <WrapPanel x:Name="KnowledgeScopes" />
                            <TextBlock Text="私有：只有你自己能看到，不会发给任何对象。"
                                       FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnSaveKnowledge" Content="保存" Style="{StaticResource Primary}"
                                        Click="OnSaveKnowledge" AutomationProperties.Name="保存知识条目" />
                                <Button Content="取消" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                        Click="OnCancelKnowledge" AutomationProperties.Name="取消编辑知识" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="False" Margin="0,16,0,8">
                        <TextBlock Text="已有知识" Style="{StaticResource H2}" DockPanel.Dock="Left" />
                        <TextBlock x:Name="KnowledgeCount" DockPanel.Dock="Right" Style="{StaticResource Small}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="KnowledgeList" Style="{StaticResource SelfList}" MaxHeight="460">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="编辑" Style="{StaticResource Ghost}" Padding="10,3"
                                                    Click="OnEditKnowledge" AutomationProperties.Name="编辑这条知识" />
                                            <Button Content="删除" Style="{StaticResource Ghost}" Padding="10,3" Margin="6,0,0,0"
                                                    Click="OnDeleteKnowledge" AutomationProperties.Name="删除这条知识" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="14" LineHeight="20"
                                               Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                                               MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding ScopePills}" ItemTemplate="{StaticResource ScopePillTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Border Style="{StaticResource Pill}" Margin="2,0,0,4">
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                        </Border>
                                    </StackPanel>
                                    <Border Visibility="{Binding FromObject, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="{DynamicResource Warn}" BorderThickness="2,0,0,0"
                                            Padding="8,2,0,2" Margin="0,4,0,0">
                                        <TextBlock Text="尚未提升为共享信息，只有这个对象可见"
                                                   FontSize="14" LineHeight="20" Foreground="{DynamicResource Warn}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="KnowledgeEmpty" Text="还没有知识条目。点「新增知识」写一条。"
                               FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}" Margin="12,4,0,0" />
                </StackPanel>

                <!-- ══════════ 3. 对象权限（关系层） ══════════ -->
                <StackPanel x:Name="SecPolicy" Visibility="Collapsed">
                    <TextBlock Text="对象权限" Style="{StaticResource H2}" />
                    <TextBlock Text="只对这个对象生效。未登记的对象默认只能看公开信息，且分身关闭。"
                               Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="筛选联系人" Target="{Binding ElementName=TxtPolicyFilter}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TxtPolicyFilter" AutomationProperties.Name="筛选联系人"
                                     ToolTip="按名字、备注或 wxid 筛选" TextChanged="OnPolicyFilterChanged" />
                            <TextBlock x:Name="PolicySummary" Style="{StaticResource Small}" Margin="2,6,0,0" />
                            <TextBlock Text="已登记" Style="{StaticResource Label}" Margin="2,10,0,4" />
                            <ListBox x:Name="RegisteredList" Style="{StaticResource SelfList}" MaxHeight="280"
                                     ItemTemplate="{StaticResource PolicyRowTemplate}"
                                     SelectionChanged="OnRegisteredSelected" AutomationProperties.Name="已登记对象列表" />
                            <TextBlock x:Name="RegisteredEmpty" Text="还没有登记对象。"
                                       FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}"
                                       Margin="12,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="未登记" Style="{StaticResource Label}" Margin="2,12,0,4" />
                            <ListBox x:Name="UnregisteredList" Style="{StaticResource SelfList}" MaxHeight="280"
                                     ItemTemplate="{StaticResource PolicyRowTemplate}"
                                     SelectionChanged="OnUnregisteredSelected" AutomationProperties.Name="未登记对象列表" />
                            <TextBlock x:Name="UnregisteredMore" Style="{StaticResource Small}"
                                       TextWrapping="Wrap" Margin="2,2,0,0" />
                        </StackPanel>

                        <Border x:Name="PolicyEditor" Grid.Column="2" Style="{StaticResource Card}" Padding="20"
                                VerticalAlignment="Top">
                            <Grid>
                                <TextBlock x:Name="PolicyEditorEmpty" Text="从左边选一个联系人或群，设置他能看到什么。"
                                           Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}"
                                           TextWrapping="Wrap" Margin="4,8,4,8" />

                                <StackPanel x:Name="PolicyEditorBody" Visibility="Collapsed">
                                    <TextBlock x:Name="PolicyName" Style="{StaticResource H2}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="PolicyUid" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PolicyKind" Style="{StaticResource Small}" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- 未登记：先说明默认值，再允许登记 -->
                                    <StackPanel x:Name="PolicyUnregisteredPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                        <Border Background="{DynamicResource Surface3}" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="默认仅公开，在岗关闭" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}" />
                                                <TextBlock Text="登记后才能设置域、在岗、收文件和披露策略；不登记就一直按默认处理。"
                                                           FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="BtnRegisterPolicy" Content="登记此对象" Style="{StaticResource Primary}"
                                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRegisterPolicy"
                                                AutomationProperties.Name="登记此对象并启用设置" />
                                    </StackPanel>

                                    <StackPanel x:Name="PolicySettingsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Label Content="可见域（多选）" Style="{StaticResource FieldLabel}" />
                                        <WrapPanel x:Name="PolicyScopes" />
                                        <TextBlock Text="私有：只有你自己能看到，不会发给任何对象，所以不在对象设置里出现。"
                                                   FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />

                                        <Label Content="在岗" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                        <StackPanel x:Name="PolicyOnDutyPanel" Orientation="Horizontal" />
                                        <TextBlock x:Name="PolicyOnDutyHint" FontSize="14" LineHeight="20"
                                                   Foreground="{DynamicResource Text2}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                                        <CheckBox x:Name="ChkPolicyAssets" Content="允许接收文件（资产还要匹配可见域）"
                                                  Margin="0,12,0,0" Click="OnPolicyFieldChanged" />

                                        <Label Content="披露策略" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                        <StackPanel x:Name="PolicyDisclosePanel" Orientation="Horizontal" />
                                        <TextBlock x:Name="PolicyDiscloseHint" FontSize="14" LineHeight="20"
                                                   Foreground="{DynamicResource Text2}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                                        <TextBlock x:Name="PolicyRelationSummary" Style="{StaticResource Small}"
                                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                                        <Expander x:Name="PolicyRelationExpander" Header="关系层设置（只对这个对象生效）"
                                                  IsExpanded="False" Foreground="{DynamicResource Text}" Margin="0,6,0,0">
                                            <StackPanel Margin="0,6,0,0">
                                                <Label Content="称呼对方" Target="{Binding ElementName=TxtAddressAs}"
                                                       Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="TxtAddressAs" ToolTip="例如：王总、张姐"
                                                         AutomationProperties.Name="称呼对方" TextChanged="OnPolicyFieldChanged" />
                                                <Label Content="语气覆盖" Target="{Binding ElementName=TxtToneOverride}"
                                                       Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                                <TextBox x:Name="TxtToneOverride" MinHeight="58" MaxHeight="120" AcceptsReturn="True"
                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.Name="语气覆盖" TextChanged="OnPolicyFieldChanged" />
                                                <TextBlock Text="留空表示沿用自我档案里的默认语气。"
                                                           FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}" Margin="0,2,0,0" />
                                                <Label Content="不聊的话题" Target="{Binding ElementName=TxtTabooTopics}"
                                                       Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                                <TextBox x:Name="TxtTabooTopics" ToolTip="用顿号或逗号分隔，留空表示没有额外限制"
                                                         AutomationProperties.Name="不聊的话题" TextChanged="OnPolicyFieldChanged" />
                                            </StackPanel>
                                        </Expander>

                                        <Label Content="备注（只给自己看）" Target="{Binding ElementName=TxtPolicyNote}"
                                               Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                        <TextBox x:Name="TxtPolicyNote" AutomationProperties.Name="对象备注"
                                                 TextChanged="OnPolicyFieldChanged" />

                                        <DockPanel LastChildFill="False" Margin="0,14,0,0">
                                            <Button x:Name="BtnSavePolicy" Content="保存对象设置" Style="{StaticResource Primary}"
                                                    DockPanel.Dock="Left" Click="OnSavePolicy" />
                                            <Button x:Name="BtnDeletePolicy" Content="删除登记" Style="{StaticResource Ghost}"
                                                    DockPanel.Dock="Left" Margin="8,0,0,0" Click="OnDeletePolicy" />
                                            <TextBlock x:Name="PolicySaveState" DockPanel.Dock="Right" Style="{StaticResource Small}"
                                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ══════════ 4. 可分享资产 ══════════ -->
                <StackPanel x:Name="SecAssets" Visibility="Collapsed">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="可分享资产" Style="{StaticResource H2}" />
                            <TextBlock Text="只有域匹配、且对象允许收文件时才会发送；导入时复制到数据目录。"
                                       Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnImportAssets" DockPanel.Dock="Right" Content="导入文件" Style="{StaticResource Primary}"
                                VerticalAlignment="Center" Click="OnImportAsset" AutomationProperties.Name="导入可分享资产" />
                    </DockPanel>
                    <TextBlock x:Name="AssetLimit" Text="单文件不超过 20 MiB，最多 500 个。"
                               Style="{StaticResource Small}" Margin="0,6,0,0" />

                    <Border x:Name="AssetImportPanel" Style="{StaticResource Card}" Padding="20" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="导入资产" Style="{StaticResource H2}" />
                            <TextBlock x:Name="AssetImportFile" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Label Content="标题" Target="{Binding ElementName=TxtAssetTitle}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <TextBox x:Name="TxtAssetTitle" MaxLength="60" AutomationProperties.Name="资产标题" />
                            <Label Content="可发送给谁" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <WrapPanel x:Name="AssetScopes" />
                            <TextBlock Text="私有：只有你自己能看到，不会发给任何对象。"
                                       FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}" Margin="0,2,0,0" />
                            <Label Content="关键词" Target="{Binding ElementName=TxtAssetKeywords}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <TextBox x:Name="TxtAssetKeywords" AutomationProperties.Name="资产关键词"
                                     ToolTip="用顿号或逗号分隔，例如：架构图、订单中心" />
                            <Label Content="备注（只给自己看）" Target="{Binding ElementName=TxtAssetNote}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <TextBox x:Name="TxtAssetNote" AutomationProperties.Name="资产备注" />
                            <TextBlock x:Name="AssetImportError" Foreground="{DynamicResource Bad}" FontSize="12" LineHeight="16"
                                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnSaveAsset" Content="导入" Style="{StaticResource Primary}"
                                        Click="OnSaveAsset" AutomationProperties.Name="确认导入资产" />
                                <Button Content="取消" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnCancelAsset" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="False" Margin="0,16,0,8">
                        <TextBlock Text="已导入" Style="{StaticResource H2}" DockPanel.Dock="Left" />
                        <TextBlock x:Name="AssetCount" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="AssetList" Style="{StaticResource SelfList}" MaxHeight="460">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                        <Button DockPanel.Dock="Right" Content="删除" Style="{StaticResource Ghost}" Padding="10,3"
                                                Click="OnDeleteAsset" AutomationProperties.Name="删除这个资产" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Small}" Margin="0,3,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding ScopePills}" ItemTemplate="{StaticResource ScopePillTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding KeywordsLine}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" Margin="2,0,0,4" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="AssetEmpty" Text="还没有可分享文件。点「导入文件」选一个。"
                               FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}" Margin="12,4,0,0" />
                </StackPanel>

                <!-- ══════════ 5. 在岗 ══════════ -->
                <StackPanel x:Name="SecOnDuty" Visibility="Collapsed">
                    <TextBlock Text="在岗" Style="{StaticResource H2}" />
                    <TextBlock Text="开启后，只在工作时段内、对设置为「先给我确认」或「直接发送」的对象代回。"
                               Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock x:Name="OnDutyStateTitle" Text="在岗已关闭" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" />
                                <TextBlock x:Name="OnDutyStateDetail" Style="{StaticResource Small}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" MaxWidth="520" />
                            </StackPanel>
                            <CheckBox x:Name="ChkOnDuty" DockPanel.Dock="Right" Content="开启在岗"
                                      VerticalAlignment="Center" FontSize="14"
                                      Click="OnToggleOnDuty" AutomationProperties.Name="在岗总开关" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="工作时段" Style="{StaticResource H2}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="开始" Target="{Binding ElementName=TxtDutyStart}" Style="{StaticResource FieldLabel}" />
                                    <ui:TimeField x:Name="TxtDutyStart" Mode="Clock" AllowEmpty="False" Label="开始时间"
                                                  AutomationProperties.Name="在岗开始时间" TextChanged="OnDutyFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="结束" Target="{Binding ElementName=TxtDutyEnd}" Style="{StaticResource FieldLabel}" />
                                    <ui:TimeField x:Name="TxtDutyEnd" Mode="Clock" AllowEmpty="False" Label="结束时间"
                                                  AutomationProperties.Name="在岗结束时间" TextChanged="OnDutyFieldChanged" />
                                </StackPanel>
                            </Grid>
                            <Label Content="星期" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                            <WrapPanel x:Name="DutyDays" />
                            <TextBlock x:Name="DutyError" Foreground="{DynamicResource Bad}" FontSize="12" LineHeight="16"
                                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"
                                       AutomationProperties.LiveSetting="Polite" />

                            <Expander Header="敏感话题（高级）" IsExpanded="False" Foreground="{DynamicResource Text}"
                                      Margin="0,12,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="碰到这些话题一律先问你，不会直接代回。用顿号、逗号或换行分隔。"
                                               FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}"
                                               TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBox x:Name="TxtSensitive" MinHeight="76" MaxHeight="180" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="敏感话题" TextChanged="OnDutyFieldChanged" />
                                </StackPanel>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnSaveDuty" Content="保存时段与敏感话题" Style="{StaticResource Primary}"
                                        Click="OnSaveDuty" />
                                <TextBlock x:Name="DutySaveState" Style="{StaticResource Small}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="PendingHeading" Text="待确认" Style="{StaticResource H2}" Margin="0,18,0,0" />
                    <TextBlock x:Name="PendingHint" Text="这些回复还没发出去。「直接发送」会立即以你的身份发给对方。"
                               Style="{StaticResource Body1}" Foreground="{DynamicResource Text2}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <DockPanel LastChildFill="False" Margin="0,8,0,6">
                        <TextBlock x:Name="PendingCount" DockPanel.Dock="Left" Style="{StaticResource Small}" />
                    </DockPanel>
                    <ListBox x:Name="PendingList" Style="{StaticResource SelfList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Padding="6,1" Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasKind, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{DynamicResource Text2}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Small}" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource Pill}" BorderBrush="{DynamicResource Warn}" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding ReasonText}" FontSize="12" Foreground="{DynamicResource Warn}" />
                                        </Border>
                                        <TextBlock Text="{Binding SourceLine}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" Margin="0,0,0,4"
                                                   Visibility="{Binding HasSourceLine, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" FontSize="14" LineHeight="20"
                                               Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding AssetLine}" Style="{StaticResource Small}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Visibility="{Binding HasAssets, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                        <Button Content="直接发送" Style="{StaticResource Primary}" Padding="12,4"
                                                Click="OnSendPending" AutomationProperties.Name="直接发送这条待确认回复" />
                                        <Button Content="编辑后发送" Style="{StaticResource Ghost}" Padding="12,4" Margin="8,0,0,0"
                                                Click="OnEditPending" AutomationProperties.Name="编辑后发送这条待确认回复" />
                                        <Button Content="丢弃" Style="{StaticResource Ghost}" Padding="12,4" Margin="8,0,0,0"
                                                Click="OnDiscardPending" AutomationProperties.Name="丢弃这条待确认回复" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="180"
                                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="修改待发送内容" />
                                        <TextBlock Text="{Binding EditError}" Foreground="{DynamicResource Bad}"
                                                   FontSize="12" LineHeight="16" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasEditError, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="发送修改后的内容" Style="{StaticResource Primary}" Padding="12,4"
                                                    Click="OnSendPendingEdited" />
                                            <Button Content="取消" Style="{StaticResource Ghost}" Padding="12,4" Margin="8,0,0,0"
                                                    Click="OnCancelEditPending" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="PendingEmpty" Text="没有待确认的回复。"
                               FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}" Margin="12,4,0,0" />

                    <Grid Margin="0,20,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已处理" Style="{StaticResource H2}" />
                            <TextBlock x:Name="HandledCount" Style="{StaticResource Small}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <Button x:Name="BtnMoreHandled" Grid.Column="1" Content="显示更多" Style="{StaticResource Ghost}"
                                Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="OnToggleHandled" AutomationProperties.Name="显示更多已处理记录" />
                        <Button x:Name="BtnClearHandled" Grid.Column="2" Content="清除已处理" Style="{StaticResource Ghost}"
                                Padding="10,4" VerticalAlignment="Center" Click="OnClearHandled"
                                AutomationProperties.Name="清除已处理记录" />
                    </Grid>
                    <ListBox x:Name="HandledList" Style="{StaticResource SelfList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="260" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="6,1" Margin="4,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasKind, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{DynamicResource Text2}" />
                                        </Border>
                                        <!-- 回执：文字写清结果，颜色只做辅助；失败原因为空时不拼一个空的冒号。 -->
                                        <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Dim}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="ok">
                                                                <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="bad">
                                                                <Setter Property="Fill" Value="{DynamicResource Bad}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="warn">
                                                                <Setter Property="Fill" Value="{DynamicResource Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="{Binding ReceiptText}" FontSize="12" LineHeight="16"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                                                        <Setter Property="Effect" Value="{DynamicResource TextHalo}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="ok">
                                                                <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="bad">
                                                                <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReceiptTone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{Binding TimeText}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Text}" FontSize="14" LineHeight="20"
                                               Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding AssetLine}" Style="{StaticResource Small}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Visibility="{Binding HasAssets, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="HandledEmpty" Text="还没有已处理记录。"
                               FontSize="14" LineHeight="20" Foreground="{DynamicResource Text2}" Margin="12,4,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
