<UserControl x:Class="WhaleLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 对话预算专用的细滑轨：4px 轨道 + 18px 圆头滑块，和全局 Slider 同一手感 -->
        <Style x:Key="BudgetSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource LineSoft}" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18">
                                                    <Ellipse Fill="{DynamicResource Accent}" />
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Bg}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot" Margin="24,20,24,20">
        <Grid x:Name="SettingsView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="PageHeader" Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="设置" Style="{StaticResource H1}" />
                <TextBlock Text="外观、高级选项与诊断工具。" Foreground="{DynamicResource Text2}"
                           FontSize="14" LineHeight="20" Margin="0,4,0,0" />
                <!-- 搜索常驻页头，滚动时也不消失；结果卡插在内容区最上面 -->
                <Grid Margin="0,14,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBox x:Name="SettingsSearch" Width="640"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                             AutomationProperties.Name="搜索设置项"
                             ToolTip="输入即筛；Esc 退出" />
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索设置项：主题、预算、链接…（Esc 退出）"
                               Foreground="{DynamicResource Dim}" FontSize="12"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </StackPanel>

            <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
                <StackPanel x:Name="SectionsHost" Margin="0,0,8,0" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="KernelHint" Style="{StaticResource Small}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel x:Name="UndoBar" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock x:Name="UndoText" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    <Button x:Name="UndoButton" Content="撤销" Style="{StaticResource Ghost}" Padding="10,2"
                            Margin="8,0,0,0" Click="OnUndoReset" AutomationProperties.Name="撤销恢复默认" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 诊断作为设置子页，不再占主导航；返回时恢复设置页。 -->
        <Grid x:Name="SubPageView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                <Button Content="← 返回设置" Style="{StaticResource Ghost}" Click="OnBackFromSubPage"
                        AutomationProperties.Name="返回设置" />
            </DockPanel>
            <ContentControl x:Name="SubPageContent" Grid.Row="1" Focusable="False" FocusVisualStyle="{x:Null}" />
        </Grid>
    </Grid>
</UserControl>
