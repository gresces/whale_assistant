<UserControl x:Class="WhaleLauncher.Views.StickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid x:Name="PageRoot" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="PageHeader" Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="表情包" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleStatus" Style="{StaticResource Small}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="分类、上传与真实消息测试。" Foreground="{DynamicResource Text2}"
                           FontSize="14" LineHeight="20" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="打开总目录" Style="{StaticResource Ghost}" Click="OnOpenFolder"
                        ToolTip="打开表情包库根目录（data\stickers）" />
                <Button Content="刷新" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnReload" />
            </StackPanel>
        </DockPanel>

        <!-- 默认只留总开关、频率和必发；目录与测试收进一个高级折叠 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="ChkEnabled" Content="启用表情包" VerticalAlignment="Center" Click="OnToggleEnabled" />
                    <TextBlock x:Name="DirHint" Style="{StaticResource Small}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </WrapPanel>

                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Text="表情包频率" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    <Slider x:Name="SldDemand" Width="220" Margin="8,0,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="OnDemandChanged"
                            ToolTip="这一轮要不要提醒她带一张；不是最终发送概率" />
                    <TextBlock x:Name="TxtDemandValue" Width="46" Margin="8,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Small}" />
                    <CheckBox x:Name="ChkEnsure" Click="OnEnsureChanged" Content="没写标记也补一张" Margin="10,0,0,0" VerticalAlignment="Center"
                              ToolTip="命中频率的轮次，模型没写 [[sticker:分类]] 也由程序按语气补一张；难过/求助时不发" />
                </WrapPanel>
                <TextBlock x:Name="DemandHint" Visibility="Collapsed" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="0 = 只靠模型自觉；100% = 每轮都提醒。" />

                <Expander Header="高级" IsExpanded="False" Foreground="{DynamicResource Text}" Margin="0,12,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <WrapPanel>
                            <TextBlock Text="目录" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtDir" Width="260" VerticalAlignment="Center" LostFocus="OnSaveStickerSettings"
                                     ToolTip="相对路径，分类是它下面的文件夹" />
                            <TextBlock Text="接收会话" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="16,0,6,0" />
                            <TextBox x:Name="TxtTestChat" Width="160" VerticalAlignment="Center"
                                     ToolTip="填微信里的备注名/昵称；默认用设置里的测试会话" />
                            <Button Content="排队测试发送" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnTestSend" />
                        </WrapPanel>
                        <TextBlock Text="测试会发一条真实消息，可能短暂切换微信窗口。"
                                   Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="ChkCollect" Content="自动收集收到的表情包" Click="OnToggleCollect" VerticalAlignment="Center" />
                            <Button Content="打开收集文件夹" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnOpenCollected" />
                        </WrapPanel>
                        <TextBlock x:Name="CollectStatus" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center" />
            <TextBlock Text="分类名" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <TextBox x:Name="TxtNewCat" Width="110" ToolTip="新分类的名字（文件夹会同名建出来）" />
            <Button x:Name="BtnAddCat" Content="＋ 新分类" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="OnAddCategory" />
            <Button x:Name="BtnDelCat" Content="删除分类" Style="{StaticResource Ghost}" Margin="6,0,0,0"
                    Visibility="Collapsed" Click="OnDeleteCategory"
                    ToolTip="只从列表里去掉，文件夹和图片都保留" />
            <Button x:Name="BtnUpload" Content="上传图片…" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnUpload"
                    ToolTip="选 1~5 张图片存进当前分类（单张 4MB 以内，不会发消息）" />
            <Button x:Name="BtnImportPresets" Content="导入预设表情包" Style="{StaticResource Ghost}"
                    Margin="6,0,0,0" Click="OnImportPresets" IsEnabled="False"
                    ToolTip="启动内核并开启表情包后可用" />
            <Button x:Name="BtnOpenCat" Content="打开本分类文件夹" Style="{StaticResource Ghost}" Margin="6,0,0,0"
                    Click="OnOpenCategoryFolder" ToolTip="打开当前分类文件夹，把图拖进去即可" />
            <TextBlock x:Name="QueueInfo" Style="{StaticResource Small}" Margin="14,0,0,0" VerticalAlignment="Center" />
        </WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,10">
                    <WrapPanel x:Name="GridHost" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" />
            <StackPanel x:Name="JobsHost" Margin="0,6,0,0" />
        </DockPanel>
    </Grid>
</UserControl>
